{
    "name": "sesuva/blog",
    "description": "Basit, bağımsız blog paketı. Post, Category, Tag yönetimi.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "blog",
        "post",
        "category",
        "tag",
        "content",
        "article",
        "türkçe",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Sesuva\\Blog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sesuva\\Blog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sesuva\\Blog\\BlogServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
